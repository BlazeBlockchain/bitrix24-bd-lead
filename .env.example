# Bitrix24 Webhook URL
# How to get it:
# 1. Go to your Bitrix24 → left menu → Applications → Webhooks
# 2. Click "Add inbound webhook"
# 3. Enable permissions: CRM (crm) + Tasks (task)
# 4. Copy the URL — it looks like:
#    https://yourcompany.bitrix24.com/rest/1/abc123xyz/
#
# Paste it below (keep the trailing slash):
BITRIX24_WEBHOOK_URL=https://yourcompany.bitrix24.com/rest/USER_ID/WEBHOOK_TOKEN/

# ─── Backend (FastAPI) skeleton vars (T004+) ───────────────────────────────────
# See backend/ + docker-compose.yml + docs/ARCHITECTURE.md
# These are for the Python backend service. Auth/encryption/LLM in later tasks.
POSTGRES_USER=bdlead
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=bdlead_db
DATABASE_URL=postgresql+asyncpg://bdlead:dev-password@localhost:5432/bdlead_db

# CRM tokens for demo/stub /api/leads/push (auth is stub; real per-user vault T006)
# Use either (or pass ?token= in dev requests)
DEFAULT_CRM_PROVIDER=bitrix24
# BITRIX24_WEBHOOK_URL=... (see top)
HUBSPOT_ACCESS_TOKEN=

# Google OAuth (T005+ full implementation)
# Create a project at https://console.cloud.google.com/apis/credentials
# Set the Authorized JavaScript Origins to your frontend URL
# Set the Authorized Redirect URI to postmessage (for Google Identity Services)
# Also set VITE_GOOGLE_CLIENT_ID in web/.env for the frontend build
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT (issued by backend after Google auth verification)
JWT_SECRET=dev-jwt-secret-change-me-in-prod
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# DEMO_AUTH_TOKEN= (kept for backward compat, no longer used)

# LLM proxy (T007): Gemini 2.5 Flash primary + Claude Haiku fallback (server-side only)
# Leave empty for mock mode (used in tests + demo flows; see llm_service).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# LLM_DAILY_BUDGET_CENTS=200

# Encryption (T006 vault + T030 skill IP): master KEK for envelope encryption of CRM tokens and
# the server-side BD Lead Research skill methodology (Fernet). Must be >=32 bytes (base64 or raw;
# see app/services/token_vault.py and app/services/skill_loader.py). CHANGE IN PROD. Never commit real value.
# After setting in production, run `make encrypt-skill` to re-encrypt the skill artifact.
# ENCRYPTION_KEK=change-this-to-32-byte-secret-for-t006-vault-prod


