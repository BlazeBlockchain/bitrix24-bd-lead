# Staging environment overrides.
# Copy to .env.staging ON THE SERVER and fill in real values before deploying.
# .env.staging is gitignored and is NOT transferred by any deploy target — it must
# already exist in the deploy directory before the first `docker compose up`.
#
# Deploy reads this file with --env-file, NOT just `env_file:`. That distinction
# matters: `env_file:` only injects variables into a running container, while
# ${VAR} interpolation in docker-compose.yml — which is how the web image gets its
# VITE_GOOGLE_CLIENT_ID BUILD ARG — reads the --env-file/.env file instead. Set
# GOOGLE_CLIENT_ID here or the web bundle builds with an empty client ID and the
# Google sign-in button silently does nothing.
#
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml -f docker-compose.staging.yml -p bdlead-staging up --build -d

POSTGRES_USER=bdlead
POSTGRES_PASSWORD=change-me-staging-password
POSTGRES_DB=bdlead_db

DATABASE_URL=postgresql+asyncpg://bdlead:change-me-staging-password@bdlead-db:5432/bdlead_db

DEFAULT_CRM_PROVIDER=bitrix24
BITRIX24_WEBHOOK_URL=
HUBSPOT_ACCESS_TOKEN=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Used twice: the backend verifies ID tokens against it, and it is baked into the
# web bundle at BUILD time as VITE_GOOGLE_CLIENT_ID. Changing it therefore requires
# a rebuild (`up --build`), never just a restart.
# The deployed origin must also be registered in Google Cloud Console as an
# Authorised JavaScript origin, or sign-in fails in the browser before it ever
# reaches this backend.
GOOGLE_CLIENT_ID=

# Who may sign in. Comma-separated; entries are full addresses ("rep@example.com")
# or domains ("@example.com"). LEAVING THIS EMPTY LETS ANY GOOGLE ACCOUNT IN.
AUTH_EMAIL_ALLOWLIST=

# 32+ chars. Web JWTs last 60 minutes, so a demo left open over a long lunch will
# log people back out — that is the token lifetime, not a bug.
JWT_SECRET=change-me-staging-jwt-secret
DEMO_AUTH_TOKEN=demo-stub-jwt

# ─── LLM ──────────────────────────────────────────────────────────────────────
# WITHOUT GEMINI_API_KEY EVERY BRIEF SILENTLY FALLS BACK TO THE DETERMINISTIC MOCK,
# and a mock brief carries no citation at all. "No source links anywhere on any
# lead" is the symptom of a missing key, not of a retrieval failure.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_CENTS=200

# 010 retrieval. RETRIEVAL_ENABLED=false is the one-flag kill switch if grounded
# search misbehaves mid-demo; briefs then degrade to the 009 presentation, no error.
RETRIEVAL_ENABLED=true
RETRIEVAL_TIMEOUT_SECONDS=6.0

# 32+ bytes. Envelope-encrypts stored CRM tokens. An unset value falls back to a
# hardcoded dev key inside token_vault — survivable for a demo holding no real CRM
# credentials, NOT survivable if this environment ever takes real ones.
ENCRYPTION_KEK=change-this-to-32-byte-secret-for-staging-vault

# Loopback-bound by docker-compose.yml; the demo is served via the shared nginx
# stack over bbspace_net, not off this port.
WEB_PORT=8080
