# Dependencies
node_modules/

# Build output
build/
*.tsbuildinfo

# Environment & secrets
# NOTE: real env files must never be committed — only the *.example templates.
# docker-compose.staging.yml expects a .env.staging holding staging DB creds +
# ENCRYPTION_KEK (which decrypts the BD Lead Research skill), so it is ignored here.
.env
.env.local
.env.*.local
.env.staging
.env.production
!.env.example
!.env.staging.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / Editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python virtual envs
.venv/
venv/
.venv*/
venv*/

# Coverage / test artifacts
coverage/
.nyc_output/

