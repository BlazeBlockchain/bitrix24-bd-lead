{
  "manifest_version": 3,
  "name": "BD Lead AI",
  "version": "0.1.2",
  "description": "Paste a signal. Get AI-enriched preview + 3 perfect follow-up tasks. Push to Bitrix24 or HubSpot in seconds.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.bdlead.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BD Lead AI"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
